# 后端服务端口
PORT=4000

# ===== Supabase 云端数据库配置 =====
# 在 Supabase 项目 -> Settings -> API 中复制以下信息
SUPABASE_URL=https://你的项目-ref.supabase.co

# 服务端建议使用 service_role key（可绕过 RLS）；本地演示也可用 anon key
SUPABASE_ANON_KEY=你的anon_key
SUPABASE_SERVICE_ROLE_KEY=你的service_role_key

# 说明：以上两项留空时，后端会自动使用本地 JSON 文件存储，便于先在本地跑通项目。
